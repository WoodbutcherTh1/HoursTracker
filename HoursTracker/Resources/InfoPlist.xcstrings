{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleDisplayName": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "HoursTracker"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HoursTracker"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "HoursTracker"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نحتاج الكاميرا لتصوير جدول ساعات مطبوع واستيراد أوقات الدخول والخروج."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HoursTracker uses the camera only to photograph a printed timesheet so you can import clock-in and clock-out times."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האפליקציה משתמשת במצלמה רק כדי לצלם דוח שעות מודפס ולייבא שעות כניסה ויציאה."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نحتاج الوصول للصور لاستيراد لقطة شاشة أو صورة لجدول الساعات."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HoursTracker needs photo access only to import a timesheet screenshot or image you choose."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האפליקציה צריכה גישה לתמונות רק כדי לייבא צילום מסך או תמונה של דוח שעות שתבחר."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نستخدم موقعك أثناء الاستخدام فقط لحفظ مكان عملك عندما تضغط «تعيين الموقع»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HoursTracker uses your location while using the app only to save your workplace when you tap Set Location."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האפליקציה משתמשת במיקום בזמן השימוש רק כדי לשמור את מקום העבודה כשתלחץ על הגדרת מיקום."
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُستخدم موقع «دائماً» فقط لتذكيرات الوصول عبر منطقة عمل واحدة حفظتها. لا نتتبعك باستمرار."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always location is used only for workplace arrival reminders via a single geofence around the workplace you saved. We do not continuously track you."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מיקום תמיד משמש רק לתזכורות הגעה דרך גדר וירטואלית אחת סביב מקום העבודה ששמרת. אין מעקב רציף."
          }
        }
      }
    }
  },
  "version": "1.0"
}
