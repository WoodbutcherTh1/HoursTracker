    "CFBundleName" : {
      "comment" : "Bundle name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "HoursTracker"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HoursTracker"
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نحتاج الكاميرا لتصوير جدول ساعات مطبوع واستيراد أوقات الدخول والخروج."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HoursTracker uses the camera only to photograph a printed timesheet so you can import clock-in and clock-out times."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "האפליקציה משתמשת במצלמה רק כדי לצלם דוח שעות מודפס ולייבא שעות כניסה ויציאה."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HoursTracker использует камеру только для того, чтобы сфотографировать распечатанный табель и импортировать время начала и окончания смен."
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "comment" : "Privacy - Face ID Usage Description",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم HoursTracker Face ID فقط لفتح قفل التطبيق عند تفعيل قفل التطبيق."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HoursTracker uses Face ID only to unlock the app when App Lock is enabled."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HoursTracker משתמשת ב‑Face ID רק לפתיחת האפליקציה כשנעילת האפליקציה מופעלת."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HoursTracker использует Face ID только для разблокировки приложения, когда включена блокировка приложения."
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location Always and When In Use Usage Description",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُستخدم إذن «دائماً» فقط لتذكيرات الوصول الاختيارية عبر مراقبة منطقة (geofence) واحدة تحددها. HoursTracker لا يتتبع موقعك باستمرار في الخلفية."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Always access is used only for optional workplace arrival reminders via region monitoring (one geofence you set). HoursTracker does not continuously track your location in the background."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גישת «תמיד» משמשת רק לתזכורות הגעה אופציונליות דרך ניטור אזור (גדר וירטואלית אחת שתגדיר). HoursTracker לא עוקב אחרי המיקום ברציפות ברקע."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ «Всегда» используется только для необязательных напоминаний о прибытии на работу через отслеживание одной заданной вами зоны. HoursTracker не отслеживает ваше местоположение постоянно в фоновом режиме."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نستخدم موقعك أثناء الاستخدام فقط لحفظ مكان عملك عندما تضغط «تعيين الموقع»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HoursTracker uses your location while using the app only to save your workplace when you tap Set Location."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "האפליקציה משתמשת במיקום בזמן השימוש רק כדי לשמור את מקום העבודה כשתלחץ על הגדרת מיקום."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HoursTracker использует ваше местоположение во время работы с приложением только для сохранения места работы, когда вы нажимаете «Указать местоположение»."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Privacy - Photo Library Usage Description",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نحتاج الوصول للصور لاستيراد لقطة شاشة أو صورة لجدول الساعات."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HoursTracker needs photo access only to import a timesheet screenshot or image you choose."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "האפליקציה צריכה גישה לתמונות רק כדי לייבא צילום מסך או תמונה של דוח שעות שתבחר."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HoursTracker нужен доступ к фото только для импорта выбранного вами скриншота или изображения табеля."
          }
        }
      }
    }
  },
  "version" : "1.0"
}