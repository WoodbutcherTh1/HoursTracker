    "settings.arrivalHint" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند التفعيل، يطلب التطبيق موقع «دائماً» ويذكّرك بتسجيل الدخول عند وصولك لمنطقة مكان العمل المحفوظ. لا يوجد تتبع مستمر."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, the app asks for Always location and reminds you to clock in when you arrive at your saved workplace geofence. Continuous tracking is not used."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כשמופעל, האפליקציה מבקשת מיקום תמיד ומזכירה להחתים כניסה בהגעה לגדר הווירטואלית של מקום העבודה. אין מעקב רציף."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
