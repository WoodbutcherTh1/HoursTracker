        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עבודה ביום מנוחה או בחג משולמת 150%/175%/200%. במשמרת לילה שעות נוספות אחרי 7 שעות. הפסקות מנוכות מהשעות בתשלום."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Работа в выходной и праздник оплачивается по 150%/175%/200%. В ночную смену сверхурочные начинаются после 7 часов. Перерывы вычитаются из оплачиваемых часов."
          }
        }
      }
