    "legal.gate.declineMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بياناتك تبقى على هذا الآيفون. يمكنك تصديرها الآن، أو حذف التطبيق، أو العودة والموافقة في أي وقت."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your data stays on this iPhone. You can export it now, delete the app, or come back and agree at any time."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המידע שלכם נשאר באייפון הזה. אפשר לייצא אותו עכשיו, למחוק את האפליקציה, או לחזור ולהסכים בכל עת."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши данные остаются на этом iPhone. Можно экспортировать их сейчас, удалить приложение или вернуться и согласиться в любой момент."
          }
        }
      }
    },
    "legal.gate.declineTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن استخدام HoursTracker دون الموافقة"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HoursTracker can't be used without agreeing"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אי אפשר להשתמש ב-HoursTracker בלי להסכים"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без согласия пользоваться HoursTracker нельзя"
          }
        }
      }
    },
