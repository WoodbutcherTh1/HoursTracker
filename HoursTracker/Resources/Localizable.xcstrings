    "home.theme.wordmarkHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستبدل العنوان أعلى الشاشة الرئيسية — اتركه فارغًا للإبقاء على HoursTracker. لا يغيّر اسم أيقونة التطبيق على شاشة جهازك."
          }
