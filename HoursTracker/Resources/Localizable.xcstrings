    "scanner.conflictMessage %@" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التاريخ %@ فيه وردية مسجّلة. بدك تستبدلها بالبيانات المستوردة؟"
          }
        },
        "en" : {
          "stringUnit" : {
