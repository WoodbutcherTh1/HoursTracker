    "widgetGuide.step1" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. من الشاشة الرئيسية، اضغط مطوّلاً على أي مساحة فارغة حتى تهتز الأيقونات."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. On the Home Screen, touch and hold an empty area until the icons jiggle."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. במסך הבית, לחצו לחיצה ארוכה על אזור פנוי עד שהאייקונים יתחילו לרטוט."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. На экране «Домой» нажмите и удерживайте пустое место, пока значки не начнут покачиваться."
          }
        }
      }
    },
    "widgetGuide.step2" : {
      "extractionState" : "manual",
      "localizations" : {
