    "supportChat.error.paused" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الشات متوقف حالياً. تقدر تتواصل معنا من خيار التواصل مع الدعم."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The chat is paused right now. You can still reach us from Contact support."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הצ'אט מושהה כרגע. אפשר עדיין לפנות אלינו דרך יצירת קשר."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чат сейчас приостановлен. Напишите нам через «Связаться с поддержкой»."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แชทนี้หยุดให้บริการชั่วคราว คุณยังสามารถติดต่อเราได้จากหน้าติดต่อฝ่ายสนับสนุน"
          }
        }
      }
    },
    "supportChat.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اكتب لنا هنا، وغالباً نرد خلال يوم. لا ترسل بيانات راتبك الشخصية، اكتب وصف المشكلة فقط."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Write to us here. We usually reply within a day. Please don't send personal pay details; describe the problem instead."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כתבו לנו כאן. בדרך כלל נחזור תוך יום. אנא אל תשלחו פרטי שכר אישיים, תארו את הבעיה."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Напишите нам здесь. Обычно мы отвечаем в течение дня. Не присылайте личные данные о зарплате, опишите проблему."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เขียนข้อความถึงเราที่นี่ได้เลย โดยปกติเราจะตอบกลับภายในหนึ่งวัน กรุณาอย่าส่งรายละเอียดค่าจ้างส่วนตัว แต่ให้อธิบายปัญหาแทน"
          }
        }
      }
    },
