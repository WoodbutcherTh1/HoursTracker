    "workplaces.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعمل في أكثر من مكان؟ أضف مكان عمل — لكل مكان ورديّاته وراتبه وإعداداته الخاصة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Work at more than one place? Add a workplace — each one keeps its own shifts, pay and settings."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עובדים ביותר ממקום אחד? הוסיפו מקום עבודה — לכל אחד משמרות, שכר והגדרות משלו."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Работаете в нескольких местах? Добавьте место работы — у каждого свои смены, зарплата и настройки."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทำงานมากกว่าหนึ่งที่ใช่ไหม? เพิ่มสถานที่ทำงาน — แต่ละที่จะมีกะทำงาน เงินเดือน และการตั้งค่าของตัวเอง"
          }
        }
      }
    },
    "workplaces.hintActive" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإعدادات أدناه تخص مكان العمل المختار هنا. الورديات والراتب محفوظة بشكل منفصل لكل مكان عمل."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The settings below belong to the workplace picked here. Shifts and pay are kept separately for each workplace."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ההגדרות למטה שייכות למקום העבודה שנבחר כאן. המשמרות והשכר נשמרים בנפרד לכל מקום עבודה."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройки ниже относятся к выбранному здесь месту работы. Смены и зарплата ведутся отдельно для каждого места."
          }
        },
        "th" : {
