    "legal.gate.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لاستخدام HoursTracker، يُرجى قراءة شروط الاستخدام وسياسة الخصوصية والموافقة عليهما."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To use HoursTracker, please read and agree to the Terms of Use and the Privacy Policy."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדי להשתמש ב-HoursTracker, יש לקרוא את תנאי השימוש ואת מדיניות הפרטיות ולהסכים להם."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы пользоваться HoursTracker, прочитайте Условия использования и Политику конфиденциальности и согласитесь с ними."
          }
        }
      }
    },
    "legal.gate.checkbox" : {
      "extractionState" : "manual",
      "localizations" : {
