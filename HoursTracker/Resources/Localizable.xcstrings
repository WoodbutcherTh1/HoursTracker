    "account.delete.confirmMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيُحذف حسابك ونسخته الاحتياطية على خادمنا نهائيًا. الورديات على هذا الآيفون تبقى. لا يمكن التراجع عن ذلك."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your account and its backup on our server will be deleted for good. Shifts on this iPhone stay. This cannot be undone."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החשבון והגיבוי שלו בשרת שלנו יימחקו לצמיתות. המשמרות באייפון הזה יישארו. אי אפשר לבטל את הפעולה."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аккаунт и его копия на нашем сервере будут удалены навсегда. Смены на этом iPhone останутся. Это нельзя отменить."
          }
        }
      }
    },
