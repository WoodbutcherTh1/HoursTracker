    "assistant.enable.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُرسَل سؤالك فقط إلى ذكاء Google الاصطناعي ليفهمه. وردياتك وأجرك تبقى على هاتفك وتُحسب عليه. مجاني: 3 أسئلة يوميًا و10 أسبوعيًا."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only your question is sent to Google's AI, so it can understand it. Your shifts and pay stay on your phone and are calculated there. Free: 3 questions a day, 10 a week."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "רק השאלה שלכם נשלחת ל-AI של Google כדי להבין אותה. המשמרות והשכר נשארים בטלפון ומחושבים בו. חינם: 3 שאלות ביום, 10 בשבוע."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В ИИ Google отправляется только ваш вопрос, чтобы его понять. Смены и оплата остаются на телефоне и считаются там. Бесплатно: 3 вопроса в день, 10 в неделю."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มีเพียงคำถามของคุณเท่านั้นที่ถูกส่งไปยัง AI ของ Google เพื่อให้เข้าใจคำถาม ส่วนกะและค่าจ้างของคุณจะอยู่ในโทรศัพท์และคำนวณที่นั่น ใช้ได้ฟรี: 3 คำถามต่อวัน 10 คำถามต่อสัปดาห์"
          }
        }
      }
    },
