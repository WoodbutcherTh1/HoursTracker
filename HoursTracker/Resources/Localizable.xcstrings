    "Hear whether you're clocked in, for how long, and what you've earned so far." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل إنت بالشغل، من قديش، وقديش طلعت لهلأ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hear whether you're clocked in, for how long, and what you've earned so far."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "האם אתם במשמרת, כמה זמן, וכמה הרווחתם עד עכשיו."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На смене ли вы, сколько времени и сколько уже заработали."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ฟังว่าคุณลงเวลาเข้างานอยู่หรือไม่ นานแค่ไหนแล้ว และมีรายได้เท่าไรแล้ว"
          }
        }
      }
    },
    "Hear your hours and estimated pay for today, this week or a month." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ساعاتك وأجرك التقريبي لليوم أو الأسبوع أو الشهر."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hear your hours and estimated pay for today, this week or a month."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השעות וההכנסה המשוערת להיום, לשבוע או לחודש."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Часы и примерный заработок за день, неделю или месяц."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ฟังชั่วโมงทำงานและค่าแรงประมาณการของวันนี้ สัปดาห์นี้ หรือเดือนนี้"
