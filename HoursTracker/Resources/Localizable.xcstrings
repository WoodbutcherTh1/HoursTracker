    "dataSafety.hint" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الورديات الممسوحة بتضل بـ\"المحذوفات مؤخراً\" 30 يوم. ونسخة من كل ورديّاتك بتنحفظ على الآيفون كل يوم وبتضل 14 يوم."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deleted shifts stay in Recently deleted for 30 days. A backup of all your shifts is saved on this iPhone every day and kept for 14 days."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "משמרות שנמחקו נשמרות ב\"נמחקו לאחרונה\" 30 יום. גיבוי של כל המשמרות נשמר באייפון כל יום ונשמר 14 יום."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалённые смены хранятся в «Недавно удалённых» 30 дней. Резервная копия всех смен сохраняется на этом iPhone каждый день и хранится 14 дней."
          }
        }
      }
    },
