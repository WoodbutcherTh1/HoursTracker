    "privacy.body.controls": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من الإعدادات يمكنك تعديل الملف، إيقاف تذكيرات الوصول، حذف الورديات، مسح سجل النشاط أو تصديره، أو حذف كل البيانات على هذا الجهاز."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Settings you can edit profile fields, turn off arrival reminders, delete shifts, clear the activity log, export the log, or delete all data on this device."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בהגדרות אפשר לערוך פרופיל, לכבות תזכורות הגעה, למחוק משמרות, לנקות/לייצא יומן פעילות, או למחוק את כל הנתונים במכשיר."
          }
        }
      }
    },
