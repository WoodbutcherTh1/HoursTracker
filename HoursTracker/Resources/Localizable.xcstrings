    "settings.appLanguage.hint" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُطبَّق فوراً على كل الشاشات. «النظام» يتبع لغة الجهاز."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies immediately across the app. System follows your device language."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חל מיד על כל המסכים. «מערכת» עוקב אחרי שפת המכשיר."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Применяется сразу во всём приложении. «Системный» — как на устройстве."
          }
        }
      }
    },
    "settings.arrivalBody" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم موقع «دائماً» فقط لمراقبة منطقة عمل واحدة محفوظة لتذكيرك بتسجيل الدخول. لا يُستخدم التتبع المستمر في الخلفية. يمكنك إيقافه في أي وقت."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This uses Always location only to monitor a single geofence around your saved workplace so we can remind you to clock in. Continuous background tracking is not used. You can turn it off anytime."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נעשה שימוש במיקום תמיד רק לניטור גדר וירטואלית אחת סביב מקום העבודה השמור כדי להזכיר להחתים כניסה. אין מעקב רקע רציף. אפשר לכבות בכל עת."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Геопозиция «Всегда» используется только для одной геозоны вокруг сохранённого места работы, чтобы напомнить вам начать смену. Постоянное фоновое отслеживание не используется. Выключить можно в любой момент."
          }
        }
      }
    },
    "settings.arrivalContinue" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متابعة"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continue"
