    "scanner.backgroundHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المعالجة تعمل في الخلفية. يمكنك إغلاق هذه الشاشة والمتابعة — ستظهر مراجعة قبل أي حفظ."
          }
