    "legal.gate.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لاستخدام HoursTracker، يُرجى قراءة شروط الاستخدام وسياسة الخصوصية والموافقة عليهما."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To use HoursTracker, please read and agree to the Terms of Use and the Privacy Policy."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדי להשתמש ב-HoursTracker, יש לקרוא את תנאי השימוש ואת מדיניות הפרטיות ולהסכים להם."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы пользоваться HoursTracker, прочитайте Условия использования и Политику конфиденциальности и согласитесь с ними."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพื่อใช้งาน HoursTracker กรุณาอ่านและยอมรับข้อกำหนดการใช้งานและนโยบายความเป็นส่วนตัว"
          }
        }
      }
    },
    "legal.gate.checkbox" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قرأت شروط الاستخدام وسياسة الخصوصية وأوافق عليهما"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I have read and agree to the Terms of Use and the Privacy Policy"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קראתי ואני מסכים/ה לתנאי השימוש ולמדיניות הפרטיות"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я прочитал(а) и принимаю Условия использования и Политику конфиденциальности"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
