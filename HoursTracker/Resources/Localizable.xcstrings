    "appLock.hint" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند التفعيل، يلزم Face ID أو Touch ID أو رمز الجهاز لفتح HoursTracker بعد التشغيل أو بعد 30 ثانية في الخلفية."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When on, Face ID, Touch ID, or your device passcode is required to open HoursTracker after launch or after 30 seconds in the background."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כשמופעל, נדרשים Face ID, Touch ID או קוד המכשיר כדי לפתוח את HoursTracker אחרי הפעלה או אחרי 30 שניות ברקע."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если включено, для открытия HoursTracker после запуска или через 30 секунд в фоне нужен Face ID, Touch ID или код-пароль устройства."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อเปิดใช้งาน ต้องใช้ Face ID, Touch ID หรือรหัสผ่านอุปกรณ์เพื่อเปิด HoursTracker หลังจากเปิดแอปหรือหลังจากอยู่ในพื้นหลังเกิน 30 วินาที"
