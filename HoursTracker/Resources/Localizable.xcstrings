            "state": "translated",
            "value": "البيانات على جهازك"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data on your device"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נתונים במכשיר שלך"
          }
        }
      }
    },
    "privacy.body.data": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحفظ متتبع الساعات ملف العامل وإعدادات مكان العمل والورديات على هذا الجهاز. لا نبيع البيانات ولا نرسلها إلى خوادمنا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hours Tracker stores your worker profile, workplace settings, and work sessions on this device. Data is not sold and is not sent to our servers."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האפליקציה שומרת את פרופיל העובד, הגדרות מקום העבודה והמשמרות במכשיר זה. אין מכירת נתונים ואין שליחה לשרתים שלנו."
          }
        }
      }
    },
    "privacy.section.location": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الموقع"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מיקום"
          }
        }
      }
    },
    "privacy.body.location": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "موقع «أثناء الاستخدام» فقط لتعيين مكان العمل. موقع «دائماً»/الخلفية يُستخدم فقط إذا فعّلت تذكيرات الوصول لمراقبة منطقة عمل واحدة. لا يوجد تتبع مستمر."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While Using location is only for Set Location. Always/background location is used only if you enable Arrival reminders, to monitor a single workplace geofence. Continuous tracking is not used."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מיקום בזמן שימוש מיועד רק להגדרת מיקום. מיקום תמיד/רקע משמש רק אם הפעלת תזכורות הגעה, לניטור גדר וירטואלית אחת. אין מעקב רציף."
          }
        }
      }
    },
    "privacy.section.camera": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الكاميرا والصور"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera & photos"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מצלמה ותמונות"
          }
        }
      }
    },
    "privacy.body.camera": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُستخدم فقط عند استيراد صورة أو لقطة شاشة لجدول الساعات. المعالجة تتم على الجهاز."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used only when you import a timesheet photo or screenshot. Processing stays on-device."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בשימוש רק בייבוא תמונה או צילום מסך של דוח שעות. העיבוד נשאר במכשיר."
          }
        }
      }
    },
    "privacy.section.tracking": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التتبع والإعلانات"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tracking & ads"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מעקב ופרסומות"
          }
        }
      }
    },
    "privacy.body.tracking": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التطبيق لا يتتبعك عبر التطبيقات أو المواقع، ولا يعرض إعلانات، ولا يستخدم أدوات تحليل من طرف ثالث."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app does not track you across apps or websites, does not show ads, and does not use third-party analytics SDKs."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האפליקציה אינה עוקבת אחריך בין אפליקציות או אתרים, אינה מציגה פרסומות ואינה משתמשת ב-SDK של אנליטיקה מצד שלישי."
          }
        }
      }
    },
    "privacy.section.controls": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحكمك بالبيانات"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your controls"
          }
