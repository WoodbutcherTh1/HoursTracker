    "assistant.privacyNote" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يغادر الجهاز سوى سؤالك وتاريخ اليوم. مناوباتك وأجرك يبقيان على الجهاز."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only your question and today's date leave the phone. Your shifts and pay stay on device."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "רק השאלה שלכם ותאריך היום נשלחים החוצה. המשמרות והשכר נשארים במכשיר."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С телефона уходят только ваш вопрос и сегодняшняя дата. Смены и зарплата остаются на устройстве."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มีเพียงคำถามของคุณและวันที่ของวันนี้เท่านั้นที่ถูกส่งออกจากโทรศัพท์ กะและค่าจ้างของคุณจะอยู่ในอุปกรณ์เสมอ"
          }
        }
      }
    },
    "assistant.rateLimited" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وصلت لحد الأسئلة حاليًا. المساعد المجاني يسمح بـ3 أسئلة يوميًا و10 أسبوعيًا. مع مفتاح API خاص بك لا يوجد حد."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You've reached the question limit for now. The free assistant allows 3 questions a day and 10 a week. With your own API key there's no limit."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הגעתם למגבלת השאלות כרגע. העוזר החינמי מאפשר 3 שאלות ביום ו-10 בשבוע. עם מפתח API משלכם אין מגבלה."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лимит вопросов пока исчерпан. Бесплатный помощник: 3 вопроса в день и 10 в неделю. Со своим API-ключом ограничений нет."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณถึงขีดจำกัดคำถามแล้วในขณะนี้ ผู้ช่วยฟรีอนุญาตให้ถามได้ 3 คำถามต่อวันและ 10 คำถามต่อสัปดาห์ หากใช้ API key ของคุณเองจะไม่มีการจำกัด"
