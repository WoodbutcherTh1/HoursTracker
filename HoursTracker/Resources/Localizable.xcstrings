    "privacy.body.camera" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُستخدم فقط عند استيراد صورة أو لقطة شاشة لجدول الساعات. المعالجة تتم على الجهاز."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used only when you import a timesheet photo or screenshot. Processing stays on-device."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בשימוש רק בייבוא תמונה או צילום מסך של דוח שעות. העיבוד נשאר במכשיר."
          }
        }
      }
    },
    "privacy.body.contact" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لأسئلة الخصوصية: support@hourstracker.app"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questions about privacy: support@hourstracker.app"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לשאלות פרטיות: support@hourstracker.app"
          }
        }
      }
    },
    "privacy.body.controls" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من الإعدادات يمكنك تعديل الملف، إيقاف تذكيرات الوصول، تفعيل أو إيقاف مزامنة iCloud (وحذف نسخ المزامنة)، حذف الورديات، مسح سجل النشاط أو تصديره، أو حذف كل البيانات على هذا الجهاز وفي iCloud الخاصة بك عند توفر المزامنة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Settings you can edit profile fields, turn off arrival reminders, turn iCloud sync on or off (and delete iCloud copies), delete shifts, clear or export the activity log, or delete all data on this device and in your private iCloud when sync is available."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בהגדרות אפשר לערוך פרופיל, לכבות תזכורות הגעה, להפעיל/לכבות סנכרון iCloud (ולמחוק עותקי iCloud), למחוק משמרות, לנקות/לייצא יומן פעילות, או למחוק את כל הנתונים במכשיר וב‑iCloud הפרטי כשסנכרון זמין."
          }
        }
      }
    },
    "privacy.body.data" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحفظ HoursTracker ملف العامل وإعدادات مكان العمل والورديات على هذا الجهاز. يبقى رقم الهوية في سلسلة مفاتيح الجهاز. لا نبيع البيانات ولا نرسلها إلى خوادمنا. مزامنة iCloud الاختيارية (متوقفة افتراضياً) تخزّن الورديات والإعدادات في قاعدة iCloud الخاصة بك فقط."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HoursTracker stores your worker profile, workplace settings, and work sessions on this device. Your national ID stays in the device Keychain. Data is not sold and is not sent to our servers. Optional iCloud sync (off by default) stores sessions and settings in your private iCloud database only."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HoursTracker שומרת את פרופיל העובד, הגדרות מקום העבודה והמשמרות במכשיר זה. מספר הזהות נשמר ב‑Keychain של המכשיר. אין מכירת נתונים ואין שליחה לשרתים שלנו. סנכרון iCloud אופציונלי (כבוי כברירת מחדל) שומר משמרות והגדרות רק במסד הנתונים הפרטי שלך ב‑iCloud."
          }
        }
      }
    },
    "privacy.body.icloud" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مزامنة iCloud متوقفة افتراضياً. إذا فعّلتها، تُخزَّن الورديات وإعدادات مكان العمل (وليس رقم الهوية) في قاعدة iCloud الخاصة بك تحت حساب Apple. لا ندير خادماً يستلم هذه البيانات."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud sync is off by default. If you turn it on, sessions and workplace settings (not your national ID) are stored in your private iCloud database under your Apple ID. We do not operate a server that receives this data."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סנכרון iCloud כבוי כברירת מחדל. אם תפעילו אותו, משמרות והגדרות מקום עבודה (לא מספר הזהות) יישמרו במסד הנתונים הפרטי שלכם ב‑iCloud תחת ה‑Apple ID. אין לנו שרת שמקבל את הנתונים."
          }
        }
      }
    },
    "privacy.body.location" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "موقع «أثناء الاستخدام» فقط لتعيين مكان العمل. موقع «دائماً» يُستخدم فقط إذا فعّلت تذكيرات الوصول لمراقبة منطقة عمل واحدة. لا يُستخدم التتبع المستمر في الخلفية."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While Using location is only for Set Location. Always location is used only if you enable Arrival reminders, to monitor a single workplace geofence. Continuous background tracking is not used."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מיקום בזמן שימוש מיועד רק להגדרת מיקום. מיקום תמיד משמש רק אם הפעלת תזכורות הגעה, לניטור גדר וירטואלית אחת. אין מעקב רקע רציף."
          }
        }
      }
    },
    "privacy.body.tracking" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التطبيق لا يتتبعك عبر التطبيقات أو المواقع، ولا يعرض إعلانات، ولا يستخدم أدوات تحليل من طرف ثالث."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app does not track you across apps or websites, does not show ads, and does not use third-party analytics SDKs."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "האפליקציה אינה עוקבת אחריך בין אפליקציות או אתרים, אינה מציגה פרסומות ואינה משתמשת ב-SDK של אנליטיקה מצד שלישי."
          }
        }
      }
    },
