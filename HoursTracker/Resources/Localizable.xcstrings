    "scanner.secondaryAPIKeyHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احتياطي عند نفاد حصة Gemini. يُحفظ في Keychain. متوافق مع Groq وOpenRouter وOpenAI — نكتشف المزوّد تلقائيًا من صيغة المفتاح."
          }
