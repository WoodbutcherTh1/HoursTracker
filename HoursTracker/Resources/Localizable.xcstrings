    "assistant.notConfigured" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المساعد يحتاج الذكاء الاصطناعي السحابي. فعّله من الإعدادات ثم اسأل. مجاني: 3 أسئلة يوميًا و10 أسبوعيًا."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The assistant needs cloud AI. Turn it on in Settings, then ask away. It's free: 3 questions a day, 10 a week."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "העוזר צריך AI בענן. הפעילו אותו בהגדרות ותוכלו לשאול. זה חינם: 3 שאלות ביום, 10 בשבוע."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Помощнику нужен облачный ИИ. Включите его в Настройках и задавайте вопросы. Бесплатно: 3 вопроса в день, 10 в неделю."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ผู้ช่วยนี้ต้องใช้ AI บนคลาวด์ เปิดใช้งานในการตั้งค่าแล้วถามได้เลย ใช้ได้ฟรี: 3 คำถามต่อวัน 10 คำถามต่อสัปดาห์"
          }
        }
      }
    },
    "assistant.notConfiguredHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإعدادات ← الخصوصية والأمان ← الماسح الذكي. يُرسل سؤالك فقط لفهمه؛ ورديّاتك وأجرك تُحسب على هاتفك."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settings → Privacy & security → Smart scanner. Only your question is sent to understand it; your shifts and pay are calculated on your phone."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הגדרות ← פרטיות ואבטחה ← סורק חכם. רק השאלה נשלחת כדי להבין אותה; המשמרות והשכר מחושבים בטלפון שלכם."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройки → Конфиденциальность и безопасность → Умный сканер. Отправляется только ваш вопрос; смены и оплата считаются на телефоне."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
