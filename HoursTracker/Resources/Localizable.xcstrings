    "settings.workRulesNote": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العمل في يوم الراحة أو العيد يُدفع 150%/175%/200%. الوردية الليلية: ساعات إضافية بعد 7 ساعات. الاستراحة تُخصم من الساعات المدفوعة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rest-day and holiday work pays 150%/175%/200%. Night shifts start overtime after 7 hours. Breaks are deducted from paid hours."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עבודה ביום מנוחה או בחג משולמת 150%/175%/200%. במשמרת לילה שעות נוספות אחרי 7 שעות. הפסקות מנוכות מהשעות בתשלום."
          }
        }
      }
    },
    "₪": {
      "comment": "A currency symbol.",
      "isCommentAutoGenerated": true
