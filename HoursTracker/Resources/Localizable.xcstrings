{
  "sourceLanguage": "en",
  "strings": {
    "%@": {
      "comment": "A button that can be used to select a day of the month for the start of a pay period.",
      "isCommentAutoGenerated": true
    },
    "%@ – %@": {
      "comment": "A subheading displaying the start and end time of a work session.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ – %2$@"
          }
        }
      }
    },
    "%@ (%@)": {
      "comment": "A button that appears in the bottom of the Timesheet Scanner view. It displays the number of selected days and lets the user approve the data before it is added to the history. The argument is the string “scanner.approve”.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ (%2$@)"
          }
        }
      }
    },
    "%@: %@": {
      "comment": "A label displaying the number of children. The argument is the string “tax.numberOfChildren”.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@: %2$@"
          }
        }
      }
    },
