    "contactSupport.chatBridge.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم إرسال هذا الملاحظات بشكل مجهول. إذا كنتم ترغبون في أن نتمكن من الرد عليكم، افتحوا محادثة مباشرة مع المطوّر."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This feedback was sent anonymously. If you'd like us to be able to reply, open a direct chat with the developer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הפידבק הזה נשלח באופן אנונימי. אם תרצו שנוכל להשיב לכם, פתחו שיחה ישירה עם המפתח."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот отзыв был отправлен анонимно. Если хотите получить ответ, откройте прямой чат с разработчиком."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความคิดเห็นนี้ถูกส่งแบบไม่เปิดเผยตัวตน หากต้องการให้เราตอบกลับได้ โปรดเปิดแชทโดยตรงกับผู้พัฒนา"
          }
        }
      }
