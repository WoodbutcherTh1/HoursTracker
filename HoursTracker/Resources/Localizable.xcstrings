    "legal.gate.point.data" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بياناتك تبقى على الآيفون، إلا إذا فعّلت نسخًا احتياطيًا أو مزامنة أو ميزة ذكية."
          }
        },
        "en" : {
          "stringUnit" : {
