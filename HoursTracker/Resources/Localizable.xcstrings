    "onboarding.step1Body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجّل الدخول والخروج من التطبيق أو الويدجت أو ديناميك آيلاند — الاستراحات والدوامات الليلية ودرجات العمل الإضافي تُحسب تلقائياً."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clock in and out from the app, the home-screen widget, or the Dynamic Island — breaks, night shifts and overtime tiers are handled automatically."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התחל וסיים משמרות מהאפליקציה, מהווידג'ט או מהאי הדינמי — הפסקות, משמרות לילה ומדרגות שעות נוספות מחושבות אוטומטית."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начинайте и заканчивайте смену в приложении, в виджете на экране «Домой» или в Dynamic Island — перерывы, ночные смены и ступени сверхурочных учитываются автоматически."
          }
        }
      }
    },
    "onboarding.step1Title" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضغطة واحدة لكل دوام"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One tap, every shift"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לחיצה אחת לכל משמרת"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одно нажатие — каждая смена"
          }
        }
      }
    },
    "onboarding.step2Body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قوانين العمل الإسرائيلية مدمجة: الحدود اليومية والأسبوعية للعمل الإضافي، أيام الراحة، الأعياد وسلاسل أيام المرض — مع تقديرات إجمالي وصافي لكل دوام."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Israeli labor rules built in: daily and weekly overtime caps, rest days, holidays and sick-day streaks — with gross and net estimates for every shift."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חוקי העבודה בישראל מובנים בתוך האפליקציה: מכסות שעות נוספות יומיות ושבועיות, ימי מנוחה, חגים ורצפי ימי מחלה — עם הערכות ברוטו ונטו לכל משמרת."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Израильские трудовые правила уже встроены: дневные и недельные лимиты сверхурочных, выходные, праздники и больничные — с оценкой брутто и нетто для каждой смены."
          }
        }
      }
    },
    "onboarding.step2Title" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعرف راتبك"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Know your pay"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "דע את השכר שלך"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Знайте свою зарплату"
          }
        }
      }
    },
    "onboarding.step3Body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "معرفك الشخصي يبقى في Keychain، وبياناتك على جهازك، وميزات السحابة اختيارية فقط. يمكنك إخفاء الأجر من الشاشة المقفلة متى شئت."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your ID stays in the Keychain, data stays on your device, and cloud features are opt-in only. Hide pay from the Lock Screen whenever you want."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תעודת הזהות נשארת ב-Keychain, הנתונים נשמרים במכשיר, ותכונות הענן הן בהסכמה בלבד. ניתן להסתיר את השכר ממסך הנעילה בכל עת."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш номер удостоверения хранится в Связке ключей, данные — на вашем устройстве, облачные функции включаются только по вашему желанию. Скрывайте зарплату на экране блокировки, когда захотите."
          }
        }
      }
    },
