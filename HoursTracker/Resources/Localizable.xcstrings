    "account.signedOutHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنشئ حساباً مجانياً حتى تبقى ورديّاتك وإعداداتك محفوظة عند إعادة التثبيت أو تغيير الهاتف."
          }
