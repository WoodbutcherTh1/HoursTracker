    "dataSafety.backups.confirmMessage" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الورديات والإعدادات الحالية رح تتبدّل بهاي النسخة. قبلها بتنحفظ نسخة من الوضع الحالي، فبتقدر تتراجع."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your current shifts and settings will be replaced by this backup. A copy of the current state is saved first, so you can undo this."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המשמרות וההגדרות הנוכחיות יוחלפו בגיבוי הזה. קודם יישמר עותק של המצב הנוכחי, כך שאפשר לבטל."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текущие смены и настройки будут заменены этой копией. Сначала сохранится копия текущего состояния, так что это можно отменить."
          }
        }
      }
    },
