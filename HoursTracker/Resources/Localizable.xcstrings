    "settings.arrivalHint": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند التفعيل، يطلب التطبيق موقع «دائماً» ويذكّرك بتسجيل الدخول عند وصولك لمكان العمل المحفوظ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, the app asks for Always location and reminds you to clock in when you arrive at your saved workplace."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשמופעל, האפליקציה מבקשת מיקום תמיד ומזכירה להחתים כניסה בהגעה למקום העבודה השמור."
          }
        }
      }
    },
    "settings.arrivalNeedLocation": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عيّن موقع مكان العمل أولاً."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set your workplace location first."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגדר קודם את מיקום מקום העבודה."
          }
        }
      }
    },
    "settings.arrivalTitle": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تفعيل تذكيرات الوصول؟"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable arrival reminders?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להפעיל תזכורות הגעה?"
          }
        }
      }
    },
    "settings.arrivalBody": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم الموقع في الخلفية فقط حول منطقة مكان العمل المحفوظ لتذكيرك بتسجيل الدخول. يمكنك إيقافه في أي وقت."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This uses background location only around your saved workplace geofence so we can remind you to clock in. You can turn it off anytime."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המיקום ברקע ישמש רק סביב אזור מקום העבודה השמור כדי להזכיר להחתים כניסה. אפשר לכבות בכל עת."
          }
        }
      }
    },
