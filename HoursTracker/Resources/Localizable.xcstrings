    "sync.enabledHint" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند التفعيل، تُرفع الورديات وإعدادات مكان العمل (وليس رقم الهوية) إلى قاعدة بيانات iCloud الخاصة بك لمزامنة أجهزتك. تبقى البيانات تحت حساب Apple — وليس على خوادمنا."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When on, work sessions and workplace settings (not your national ID) upload to your private iCloud database so your other Apple devices can sync. Data stays under your Apple ID — not on our servers."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כשמופעל, משמרות והגדרות מקום עבודה (לא מספר הזהות) מועלים למסד הנתונים הפרטי שלך ב‑iCloud לסנכרון בין המכשירים. הנתונים נשארים תחת ה‑Apple ID שלך — לא בשרתים שלנו."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если включено, смены и настройки места работы (но не номер удостоверения) загружаются в вашу личную базу iCloud, чтобы синхронизироваться с другими устройствами Apple. Данные остаются под вашим Apple ID — не на наших серверах."
          }
        }
      }
    },
