    "assistant.outOfScopeHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أُجيب فقط عن أسئلة تخص مناوباتك وساعاتك وأجرك وתלושיך داخل هذا التطبيق."
