          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การประมวลผลทำงานอยู่ในพื้นหลัง คุณสามารถปิดหน้าจอนี้และใช้งานแอปต่อได้ — จะมีการแสดงหน้าตรวจสอบก่อนบันทึกข้อมูลใดๆ"
