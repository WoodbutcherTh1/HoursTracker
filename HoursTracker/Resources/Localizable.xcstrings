    "settings.workRulesNote" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "العمل في يوم الراحة أو العيد يُدفع 150%/175%/200%. الوردية الليلية: ساعات إضافية بعد 7 ساعات. الاستراحة تُخصم من الساعات المدفوعة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rest-day and holiday work pays 150%/175%/200%. Night shifts start overtime after 7 hours. Breaks are deducted from paid hours."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עבודה ביום מנוחה או בחג משולמת 150%/175%/200%. במשמרת לילה שעות נוספות אחרי 7 שעות. הפסקות מנוכות מהשעות בתשלום."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Работа в выходной и праздник оплачивается по 150%/175%/200%. В ночную смену сверхурочные начинаются после 7 часов. Перерывы вычитаются из оплачиваемых часов."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การทำงานในวันหยุดและวันหยุดนักขัตฤกษ์จ่าย 150%/175%/200% กะกลางคืนเริ่มคิดล่วงเวลาหลังจาก 7 ชั่วโมง เวลาพักจะถูกหักออกจากชั่วโมงที่ได้รับค่าจ้าง"
          }
        }
      }
    },
