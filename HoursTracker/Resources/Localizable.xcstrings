    "manual.sickHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اليوم الأول بلا أجر، يوم 2-3 نص أجر، من اليوم الرابع أجر كامل. الأجر بيتحسب أوتوماتيك — بدون ساعات دخول/خروج."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Day 1 is unpaid, days 2–3 are half pay, day 4 onward is full pay. Pay is calculated automatically — no clock-in/out needed."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יום 1 ללא תשלום, ימים 2–3 בחצי שכר, מהיום הרביעי שכר מלא. השכר מחושב אוטומטית — בלי שעות כניסה/יציאה."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1-й день не оплачивается, 2–3-й — половина оплаты, с 4-го — полная оплата. Оплата считается автоматически — отмечать начало и конец не нужно."
          }
        }
      }
    },
