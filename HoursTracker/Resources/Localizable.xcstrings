    "grid.freeText.hint" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اكتب أو الصق كيف ما بدك — تواريخ وأوقات دخول/خروج. التطبيق بحلّلها وبحطها بالجدول."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Type or paste freely — dates with clock-in and clock-out. We'll parse them into the form."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כתוב או הדבק חופשי — תאריכים עם כניסה ויציאה. ננתח ונמלא בטופס."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пишите или вставляйте свободно — даты со временем начала и конца. Мы перенесём их в форму."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พิมพ์หรือวางข้อความได้อย่างอิสระ — วันที่พร้อมเวลาเข้างานและเวลาออกงาน เราจะแยกข้อมูลลงในแบบฟอร์มให้"
          }
        }
      }
    },
