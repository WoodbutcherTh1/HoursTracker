    "settings.hideWidgetPayHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يخفي الأرباح من ويدجت الشاشة الرئيسية وديناميك آيلاند والشاشة المقفلة. يبقى راتبك مرئياً فقط داخل التطبيق."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masks earnings on home-screen widgets, the Dynamic Island and the Lock Screen. Your income stays visible only inside the app."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מסתיר את השכר בווידג'טים של מסך הבית, באי הדינמי ובמסך הנעילה. ההכנסות נשארות גלויות רק בתוך האפליקציה."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скрывает заработок в виджетах на экране «Домой», в Dynamic Island и на экране блокировки. Доход виден только внутри приложения."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ซ่อนรายได้บนวิดเจ็ตหน้าจอหลัก Dynamic Island และหน้าจอล็อก รายได้ของคุณจะแสดงให้เห็นเฉพาะภายในแอปเท่านั้น"
          }
        }
      }
