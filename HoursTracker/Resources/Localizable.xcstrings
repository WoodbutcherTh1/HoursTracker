        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המידע נשאר באייפון שלכם, אלא אם תפעילו גיבוי, סנכרון או תכונה חכמה."
          }
        },
        "ru" : {
          "stringUnit" : {
