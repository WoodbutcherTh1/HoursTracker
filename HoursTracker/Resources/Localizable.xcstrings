    "admin.autoReplies.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا احتوت الرسالة على إحدى الكلمات، يُرسل الرد فوراً بلغة المستخدم ويُعلَّم كرد تلقائي. اسحب للحذف."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When a message contains one of the keywords, the reply is sent right away in the user's language and marked as automatic. Swipe to delete."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כשהודעה מכילה אחת ממילות המפתח, התשובה נשלחת מיד בשפת המשתמש ומסומנת כאוטומטית. החליקו כדי למחוק."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если сообщение содержит одно из ключевых слов, ответ отправляется сразу на языке пользователя и помечается как автоматический. Смахните, чтобы удалить."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อข้อความมีคำสำคัญคำใดคำหนึ่ง ระบบจะส่งคำตอบกลับทันทีในภาษาของผู้ใช้ และทำเครื่องหมายว่าเป็นข้อความอัตโนมัติ ปัดเพื่อลบ"
          }
