    "employment.move.note" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "راجع الشروط الجديدة أدناه. تبقى الورديات السابقة بأجر وبدل المقاول؛ وتسري الشروط الجديدة من اليوم الأول. يتحدث كل شيء في الإعدادات بعد الحفظ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check the new terms below. Earlier shifts keep the contractor rate and allowance; the new terms apply from the first day. Everything updates in Settings when you save."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בדקו את התנאים החדשים למטה. משמרות קודמות נשארות בתעריף ובהחזר של הקבלן; התנאים החדשים חלים מהיום הראשון. הכול מתעדכן בהגדרות לאחר השמירה."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверьте новые условия ниже. Прошлые смены остаются со ставкой и компенсацией подрядчика; новые условия действуют с первого дня. Всё обновится в настройках после сохранения."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตรวจสอบเงื่อนไขใหม่ด้านล่าง กะงานก่อนหน้านี้จะยังคงใช้อัตราค่าจ้างและค่าเดินทางของผู้รับเหมา ส่วนเงื่อนไขใหม่จะมีผลตั้งแต่วันแรก ทุกอย่างจะอัปเดตในการตั้งค่าเมื่อคุณบันทึก"
          }
        }
      }
    },
